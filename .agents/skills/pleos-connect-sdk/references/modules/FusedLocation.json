      "latitude",
      "longitude",
      "radiusMeters",
      "transitionTypes"
    ],
    "transitions": [
      "ENTER",
      "EXIT"
    ],
    "radius": "finite and greater than zero"
  },
  "constraints": [
    "isSupported reports service package presence, not location accuracy."
  ]
}
