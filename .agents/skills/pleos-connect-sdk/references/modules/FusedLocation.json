      "path": "/docs/pleos-only/connect-sdk-pleos/FusedLocation/fused-location/ai.pleos.playground.location.fused/fused-location/entry",
      "methodNames": [
        "addProximityAlert",
        "getLastKnownLocation",
        "initialize",
        "isSupported",
        "registerFusedLocationCallback",
        "release",
        "removeProximityAlert",
        "showLocationAccessBlockedPopup",
        "unregisterFusedLocationCallback"
      ]
    },
    {
      "path": "/docs/pleos-only/connect-sdk-pleos/FusedLocation/fused-location/ai.pleos.playground.location.fused.listener/fused-location-listener/entry",
      "methodNames": [
        "onChanged",
        "onError"
      ]
    },
    {
      "path": "/docs/pleos-only/connect-sdk-pleos/FusedLocation/fused-location/ai.pleos.playground.location.fused.listener/proximity-alert-listener/entry",
      "methodNames": [
        "onError",
        "onRegistered",
        "onTransition"
      ]
    }
  ],
  "permissions": [
    "pleos.car.permission.FUSED_LOCATION"
  ],
  "locationFields": [
    "latitude",
    "longitude",
    "altitude",
    "heading",
    "confidence",
    "timestampMillis"
