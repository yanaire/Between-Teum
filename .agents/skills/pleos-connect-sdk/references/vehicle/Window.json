      "read": true,
      "write": true,
      "subscribe": true,
      "capability": true,
      "label": "스마트 글라스 상태"
    },
    {
      "key": "SmartGlassZone",
      "methods": [
        "checkSmartGlassZoneStateCapabilities",
        "setSmartGlassZoneState"
      ],
      "read": false,
      "write": true,
      "subscribe": false,
      "capability": true,
      "label": "스마트 글라스 패널별 설정"
    },
    {
      "key": "SmartGlassLevel",
      "methods": [
