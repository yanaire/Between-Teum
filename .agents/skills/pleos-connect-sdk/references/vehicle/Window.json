        "moveWindowBlind",
        "registerWindowBlindPosition",
        "unregisterWindowBlindPosition"
      ],
      "read": true,
      "write": true,
      "subscribe": true,
      "capability": true,
      "label": "창문 블라인드 위치·이동"
    },
    {
      "key": "SmartGlass",
      "methods": [
        "checkSmartGlassStateCapabilities",
        "getCurrentSmartGlassState",
        "setSmartGlassState",
        "registerSmartGlassState",
        "unregisterSmartGlassState"
