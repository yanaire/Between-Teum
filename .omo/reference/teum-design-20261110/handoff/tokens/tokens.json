  "motion": {
    "duration": {
      "micro": 160,
      "base": 320,
      "scene": 900,
      "cabin": 2000
    },
    "easing": {
      "enter": "cubic-bezier(0.22, 1, 0.36, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "breath": "cubic-bezier(0.37, 0, 0.63, 1)"
    },
    "breath": {
      "inhale1Ms": 2000,
      "inhale2Ms": 1000,
      "exhaleMs": 6000,
      "ambientPct": [
        20,
        45,
        60,
