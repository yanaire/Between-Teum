{
  "$meta": {
    "name": "teumteum-tokens",
    "version": "3.0.0",
    "basedOn": "pleos.tokens.json (Pleos Connect UI Design Guide v2.1.5)",
    "units": "px at Connect-S 17in (160dpi, 1px = 1dp). Other form factors: scale with pleos.tokens.json columns.",
    "note": "Layer 1 (foundation) values are references to Pleos tokens as {pleos:...}. Layer 2 (brand) values are owned here. Accent changes at runtime through --light-current."
  },
  "layout": {
    "formFactor": "S",
    "portrait": {
      "frame": [
        840,
        1184
      ],
      "marginX": 40,
      "marginTop": 40,
      "marginBottom": 40,
      "columns": 4,
      "gutter": 24,
      "default": true
    },
    "landscape": {
      "frame": [
        1700,
        1184
      ],
      "marginX": 48,
      "marginTop": 40,
      "marginBottom": 40,
      "columns": 12,
      "gutter": 24
    },
    "landscapeBreakpoint": 1200,
    "appWindowRadius": "{pleos:radius.appWindow}",
    "otherFormFactors": {
      "S14": {
        "portrait": [
          672,
          948
        ],
        "landscape": [
          1360,
          948
        ]
      },
      "L": {
        "portrait": [
          628,
          855
        ],
        "landscape": [
          1274,
          855
        ]
      },
      "W": {
        "portrait": [
          800,
          810
        ],
        "landscape": [
          1640,
          810
        ]
      },
      "WF": {
        "portrait": [
          648,
          800
        ],
        "landscape": [
          1256,
          800
        ]
      }
    },
    "systemUI_S": {
      "display": [
        2560,
        1440
      ],
      "statusBar": 96,
      "gnb": 160,
      "drivingViewWidth": 840,
      "appArea": [
        1700,
        1184
      ],
      "windowGap": 20,
      "windowRadius": 40
    }
  },
  "color": {
    "foundation": {
      "cabin.ink": {
        "pleos": "background/secondary",
        "dark": "#131417",
        "light": "#FFFFFF"
      },
      "cabin.shell": {
        "pleos": "surface/basic",
        "dark": "#1D1E21",
        "light": "#FFFFFF"
      },
      "cabin.raised": {
        "pleos": "surface/high",
        "dark": "#313236",
        "light": "#EDEEF2"
      },
      "cabin.accent": {
        "pleos": "surface/accent",
        "dark": "#44464E",
        "light": "#E0E1E6"
      },
      "cabin.popup": {
        "pleos": "background/popup",
        "dark": "#313236",
        "light": "#FFFFFF"
      },
      "cabin.line": {
        "pleos": "divider/secondary",
        "dark": "#FFFFFF1A",
        "light": "#1314171A"
      },
      "ink.primary": {
        "pleos": "text/dark/primary",
        "dark": "#FFFFFF",
        "light": "#131417"
      },
      "ink.secondary": {
        "pleos": "text/dark/secondary",
        "dark": "#FFFFFFD6",
        "light": "#131417D6"
      },
      "ink.tertiary": {
        "pleos": "text/dark/tertiary",
        "dark": "#FFFFFFA3",
        "light": "#131417A3"
      },
      "ink.disabled": {
        "pleos": "text/dark/quaternary",
        "dark": "#FFFFFF52",
        "light": "#13141752"
      },
      "ink.onLight": {
        "pleos": "static/dark/100",
        "dark": "#131417",
        "light": "#131417"
      },
      "btn.basic": {
        "pleos": "button/basic/enabled",
        "dark": "#FFFFFF0D",
        "light": "#1314170D"
      },
      "btn.basicPressed": {
        "pleos": "button/basic/pressed",
        "dark": "#FFFFFF1A",
        "light": "#1314171A"
      },
      "scrim": {
        "pleos": "overlay/default",
        "dark": "#13141780",
        "light": "#13141733"
      },
      "switch.on": {
        "pleos": "switch/on",
        "dark": "#00E074",
        "light": "#02C265"
      },
      "negative": {
        "pleos": "informative/negative",
        "dark": "#FF4C28",
        "light": "#FE3D16"
      }
    },
    "themePolicy": {
      "session": "dark (fixed) — M, C, F1~F4, Q1, I",
      "app": "system light/dark — ON, H, R, ST"
    },
    "light": {
      "moon": {
        "ui": "#C8D2E4",
        "cabin": "#B9C6E0",
        "label": "문라이트",
        "use": "기본값, 가면을 고르기 전"
      },
      "amber": {
        "ui": "#FFB45E",
        "cabin": "#FF9A2E",
        "label": "앰버",
        "use": "기상, 가면 벗은 뒤, 도착 연출"
      },
      "sleep": {
        "ui": "#2C3F8F",
        "cabin": "#1A2B8C",
        "label": "딥 나이트",
        "use": "잠들기 전환 5%"
      }
    },
    "mask": {
      "calm": {
        "ui": "#5B79FF",
        "cabin": "#2747E8",
        "label": "차분한 나",
        "hint": "긴장되는 회의가 있는 날"
      },
      "firm": {
        "ui": "#FF5B3A",
        "cabin": "#FF3B12",
        "label": "단호한 나",
        "hint": "거절하거나 협상해야 하는 날"
      },
      "warm": {
        "ui": "#FF9381",
        "cabin": "#FF6F5A",
        "label": "다정한 나",
        "hint": "사람을 많이 만나는 날"
      },
      "focus": {
        "ui": "#DCE7FF",
        "cabin": "#E6EEFF",
        "label": "집중하는 나",
        "hint": "혼자 끝낼 일이 많은 날"
      },
      "flex": {
        "ui": "#9CC5A1",
        "cabin": "#6FBF7A",
        "label": "유연한 나",
        "hint": "일정이 자주 바뀌는 날"
      }
    },
    "onAccentText": "#131417"
  },
  "font": {
    "family": {
      "ui": "'Asta Sans', system-ui, sans-serif",
      "num": "'Manrope', 'Asta Sans', system-ui, sans-serif",
      "voice": "'MaruBuri', 'Gowun Batang', serif"
    },
    "scale": {
      "num.hero": {
        "pleos": "feature.speed size",
        "size": 112,
        "lineHeight": 134,
        "weight": 300,
        "tracking": "-0.03em",
        "family": "num"
      },
      "num.l": {
        "pleos": "headline.l size",
        "size": 60,
        "lineHeight": 80,
        "weight": 300,
        "tracking": "-0.03em",
        "family": "num"
      },
      "display": {
        "pleos": "headline.s",
        "size": 48,
        "lineHeight": 64,
        "weight": 700,
        "tracking": "-0.02em",
        "family": "ui"
      },
      "title": {
        "pleos": "title.m",
        "size": 36,
        "lineHeight": 44,
        "weight": 700,
        "tracking": "-0.02em",
        "family": "ui"
      },
      "title.sub": {
        "pleos": "title.s",
        "size": 32,
        "lineHeight": 40,
        "weight": 700,
        "tracking": "-0.02em",
        "family": "ui"
      },
      "body.lead": {
        "pleos": "body.l",
        "size": 30,
        "lineHeight": 45,
        "weight": 400,
        "tracking": "0",
        "family": "ui"
      },
      "body": {
        "pleos": "body.m",
        "size": 28,
        "lineHeight": 36,
        "weight": 400,
        "tracking": "0",
        "family": "ui"
      },
      "body.min": {
        "pleos": "body.s",
        "size": 26,
        "lineHeight": 34,
        "weight": 400,
        "tracking": "0",
        "family": "ui"
      },
      "btn.l": {
        "pleos": "body.l strong",
        "size": 30,
        "lineHeight": 38,
        "weight": 700,
        "tracking": "0",
        "family": "ui"
      },
      "btn.m": {
        "pleos": "body.m strong",
        "size": 28,
        "lineHeight": 36,
        "weight": 700,
        "tracking": "0",
        "family": "ui"
      },
      "label": {
        "pleos": "label.m",
        "size": 24,
        "lineHeight": 28,
        "weight": 400,
        "tracking": "0",
        "family": "ui"
      },
      "label.min": {
        "pleos": "label.s",
        "size": 20,
        "lineHeight": 24,
        "weight": 400,
        "tracking": "0",
        "family": "ui"
      },
      "drive": {
        "pleos": "title.l",
        "size": 40,
        "lineHeight": 52,
        "weight": 700,
        "tracking": "-0.02em",
        "family": "ui",
        "use": "H-02 only (5mm rule)"
      },
      "voice.xl": {
        "pleos": null,
        "size": 48,
        "lineHeight": 72,
        "weight": 400,
        "tracking": "-0.01em",
        "family": "voice"
      },
      "voice.l": {
        "pleos": null,
        "size": 32,
        "lineHeight": 52,
        "weight": 400,
        "tracking": "-0.01em",
        "family": "voice"
      }
    }
