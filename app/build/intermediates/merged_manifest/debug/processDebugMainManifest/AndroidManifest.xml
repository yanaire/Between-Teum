<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.pleos.starter"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="35" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="ai.pleos.playground.service.vehicle.VEHICLE_BINDING" />

    <queries>
        <intent>
            <action android:name="ai.pleos.playground.vehicle.VEHICLE_START" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" >
        <activity
            android:name="dev.pleos.starter.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="ai.pleos.playground.service.vehicle.min_version_name"
            android:value="2.3.13" />
        <meta-data
            android:name="ai.pleos.playground.service.vehicle.min_version_code"
            android:value="65" />
        <meta-data
            android:name="ai.pleos.playground.sdk.vehicle.current_version_name"
            android:value="2.3.2" />
        <meta-data
            android:name="ai.pleos.playground.sdk.vehicle.current_version_code"
            android:value="73" />
    </application>

</manifest>